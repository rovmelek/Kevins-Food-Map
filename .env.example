# Copy to .env (never commit .env). One key works for both, or split them:
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BROWSER_KEY=   # Maps JavaScript API, restrict by HTTP referrer
# GOOGLE_PLACES_SERVER_KEY=  # Places API (New), restrict by server IP
# GOOGLE_MAPS_MAP_ID=        # optional; defaults to DEMO_MAP_ID (testing only)

# NASC office, used when the visitor doesn't share their location
OFFICE_NAME=NASC office
OFFICE_LAT=
OFFICE_LNG=

PORT=3000
# HOST=0.0.0.0              # only to allow other machines on your network
