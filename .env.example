# Copy to .env (never commit .env). One key for both the map and the lookups:
# enable Maps JavaScript API and Places API (New) on it.
GOOGLE_MAPS_API_KEY=
# Optional: split into two keys once the site is public (see README).
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_PLACES_SERVER_KEY=

# Optional map ID; defaults to DEMO_MAP_ID (testing only)
# GOOGLE_MAPS_MAP_ID=

# NASC office, used when the visitor doesn't share their location
OFFICE_NAME=NASC office
OFFICE_LAT=
OFFICE_LNG=

PORT=3000
# HOST=0.0.0.0              # only to allow other machines on your network
