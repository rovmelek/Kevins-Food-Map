# Copy to .env (never commit .env). Use two keys: a key restricted to
# websites is meant for browser calls, not the server's Places calls.
# Browser key: Maps JavaScript API only, restricted to Websites
GOOGLE_MAPS_BROWSER_KEY=
# Server key: Places API (New) only, restricted by server IP when hosted
GOOGLE_PLACES_SERVER_KEY=
# Or one unrestricted key for both (not recommended):
# GOOGLE_MAPS_API_KEY=

# Optional map ID; defaults to DEMO_MAP_ID (testing only)
# GOOGLE_MAPS_MAP_ID=

# NASC office, used when the visitor doesn't share their location
OFFICE_NAME=NASC office
OFFICE_LAT=
OFFICE_LNG=

PORT=3000
# HOST=0.0.0.0              # only to allow other machines on your network
