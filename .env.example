# Copy to .env (never commit .env). One key for both the map and the lookups
# is fine for trying it out: enable Maps JavaScript API and Places API (New) on it.
GOOGLE_MAPS_API_KEY=
# Optional: split into two keys once the site is public (see README). A
# Websites restriction only works on the map key: Places runs on the server,
# so it needs its own key (restricted to the server's IP address).
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_PLACES_SERVER_KEY=

# Optional: a map ID styled in Cloud console. Leave unset to use the app's
# built-in clean style (no Google places or transit icons).
# GOOGLE_MAPS_MAP_ID=

# NASC office, used when the visitor doesn't share their location
OFFICE_NAME=NASC office
OFFICE_LAT=
OFFICE_LNG=

PORT=3000
# HOST=0.0.0.0              # only to allow other machines on your network

# Admin password for the Manage window (add, edit, delete). Don't type it here:
# run `npm run set-password` (or `kevins-food-map set-password`), which stores only a hash.
# ADMIN_PASSWORD_HASH=
# Set to 1 only when behind a reverse proxy (Caddy, nginx), so the login lockout
# sees each visitor's real address instead of the proxy's.
# TRUST_PROXY=1

# Most Google Place Details lookups per day (UTC) for the Chinese names and addresses
# shown when a restaurant is opened. 0 turns them off. Default 150. Counted per
# server run (a restart starts again); every call to Google counts, failed ones
# too. Each visitor address may use half of it per 24 hours (people behind one
# address share that). Also set the "GetPlaceRequest per day"
# quota in Google Cloud console: that is the hard cap.
# PLACE_DETAILS_PER_DAY=150
