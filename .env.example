# Copy to .env (never commit .env). One key for both the map and the lookups:
# enable Maps JavaScript API and Places API (New) on it.
GOOGLE_MAPS_API_KEY=
# Optional: split into two keys once the site is public (see README).
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_PLACES_SERVER_KEY=

# Optional: a map ID styled in Cloud console. Leave unset to use the app's
# built-in clean style (no Google places or transit icons).
# GOOGLE_MAPS_MAP_ID=

# NASC office, used when the visitor doesn't share their location
OFFICE_NAME=NASC office
OFFICE_LAT=
OFFICE_LNG=

PORT=3000
# HOST=0.0.0.0              # only to allow other machines on your network

# Admin password for the Manage window (add, edit, delete). Don't type it here:
# run `npm run set-password` (or `nasc-food set-password`), which stores only a hash.
# ADMIN_PASSWORD_HASH=
# Set to 1 only when behind a reverse proxy (Caddy, nginx), so the login lockout
# sees each visitor's real address instead of the proxy's.
# TRUST_PROXY=1
