#!/usr/bin/env bash
# kevins-food-map: manage the Kevin's Food Map server as a systemd service.
#   kevins-food-map install     install and enable the service (starts on boot)
#   kevins-food-map start|stop|restart|status
#   kevins-food-map logs        follow the server log (Ctrl+C to exit)
#   kevins-food-map test        run the automated tests
#   kevins-food-map set-password  set the password for the Manage window
#   kevins-food-map update      pull new code (keeps this server's restaurant list),
#                         run tests, restart if they pass, else roll back
#   kevins-food-map move DIR    move the app folder to DIR and point the service there
#   kevins-food-map uninstall   stop and remove the service
set -euo pipefail

SERVICE=kevins-food-map
UNIT=/etc/systemd/system/$SERVICE.service
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

sudo_() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

DATA=data/restaurants.json

need_unit() {
  [ -f "$UNIT" ] || { echo "Service not installed. Run: $0 install" >&2; exit 1; }
  local installed
  installed="$(unit_value WorkingDirectory)"
  if [ "$installed" != "$DIR" ]; then
    if [ -d "$installed" ]; then
      echo "Note: the service runs the copy in $installed, not this one ($DIR)." >&2
    else
      echo "Note: the service points at $installed, which no longer exists." >&2
    fi
    echo "To run this copy instead (its .env and restaurant list become the live ones): $DIR/bin/kevins-food-map install" >&2
  fi
}
# git and npm run as the folder's owner (git refuses repos owned by others).
as_owner() { local o; o="$(stat -c %U "$DIR")"; if [ "$o" = "$(id -un)" ]; then "$@"; else as_user "$o" "$@"; fi; }
git_() { as_owner git -C "$DIR" "$@"; }
as_user() { local u="$1"; shift; if [ "$(id -u)" -eq 0 ]; then runuser -u "$u" -- "$@"; else sudo -u "$u" "$@"; fi; }
unit_value() { [ -f "$UNIT" ] && sed -n "s/^$1=//p" "$UNIT" || true; }

# systemd unit files can't hold these characters safely in paths.
check_path() {
  case "$1" in
    *[[:space:]\&\|\\%\$\"\'\;]*) echo "Can't use '$1': use a path without spaces or special characters." >&2; exit 1 ;;
  esac
}

# Writes the systemd unit. On install the service user is whoever ran the
# command (the sudo user, if any); on update it stays whatever it was.
# The service user must be able to reach the folder, read .env and write
# data/ (the list is saved as a new file renamed into place). Callers run
# this before stopping anything.
check_access() {
  local u="$1" d="$2" n="${3:-}"
  [ -n "$u" ] && [ "$u" != "$(id -un)" ] || return 0
  id "$u" > /dev/null 2>&1 || { echo "The service user $u doesn't exist. Run: $d/bin/kevins-food-map install --user NAME" >&2; exit 1; }
  as_user "$u" true || { echo "Couldn't run a check as $u (needs sudo or runuser)." >&2; exit 1; }
  if ! as_user "$u" test -x "$d"; then
    echo "$u can't open $d (a folder above it is private). Put the app where $u can reach it, e.g. its home or /srv." >&2; exit 1
  fi
  if ! as_user "$u" sh -c 'cd "$1" && { [ ! -f .env ] || [ -r .env ]; } && [ -w data ]' sh "$d"; then
    echo "$u can't read $d/.env or write $d/data. Give it the folder: sudo chown -R $u: $d" >&2; exit 1
  fi
  if [ -n "$n" ] && ! as_user "$u" test -x "$n"; then
    echo "$u can't run $n (Node installed in a private folder?). Install Node where $u can run it, e.g. /usr/local." >&2; exit 1
  fi
}
# The service's current Node, if it's still there.
unit_node() { local n; n="$(unit_value ExecStart)"; n="${n%% *}"; if [ -x "$n" ]; then echo "$n"; fi; }
# Node for a new or changed unit: the service's current one, else the one on PATH.
pick_node() {
  local n; n="$(unit_node)"
  if [ -z "$n" ]; then
    [ -z "$(unit_value ExecStart)" ] || echo "Note: the service's Node is gone; using the one on PATH." >&2
    n="$(command -v node || true)"; [ -n "$n" ] || { echo "node not found on PATH. Install Node.js 22+ first." >&2; exit 1; }
    n="$(readlink -f "$n")"; check_node_version "$n"
  fi
  echo "$n"
}
check_node_version() {
  local v; v="$("$1" -p 'process.versions.node.split(".")[0]' 2> /dev/null || echo 0)"
  [ "$v" -ge 22 ] 2> /dev/null || { echo "$1 is Node $("$1" -v 2> /dev/null || echo '?'); the app needs Node 22+ (24.7+ recommended)." >&2; exit 1; }
}
# Starts or restarts the service and reports whether it stayed up.
start_checked() {
  if sudo_ systemctl "$1" "$SERVICE" && sleep 2 && systemctl is-active --quiet "$SERVICE"; then return 0; fi
  echo "The service didn't stay up. See: kevins-food-map logs" >&2; return 1
}

render_unit() {
  local user="${1:-}" node="${2:-}"
  [ -n "$node" ] || node="$(command -v node || true)"
  [ -n "$node" ] || { echo "node not found on PATH. Install Node.js 22+ first." >&2; exit 1; }
  node="$(readlink -f "$node")"
  # A new service runs as whoever installs it (with sudo: the sudo user).
  if [ -z "$user" ]; then
    if [ "$(id -u)" -eq 0 ]; then user="${SUDO_USER:-root}"; else user="$(id -un)"; fi
  fi
  check_path "$DIR"; check_path "$node"
  if [ "$(id -u "$user")" = 0 ]; then
    echo "Warning: the service will run as root. Safer: create a user (sudo adduser --system --group foodmap), put the app under /srv, and run: bin/kevins-food-map install --user foodmap (see README, Service user)" >&2
  fi
  # Written to a temp file and renamed, so an interruption can't leave half a unit.
  sed -e "s|@USER@|$user|g" -e "s|@DIR@|$DIR|g" -e "s|@NODE@|$node|g" \
    "$DIR/deploy/kevins-food-map.service.in" | sudo_ tee "$UNIT.tmp" > /dev/null
  sudo_ chmod 644 "$UNIT.tmp"
  sudo_ mv -f "$UNIT.tmp" "$UNIT"
  sudo_ systemctl daemon-reload
  echo "Service runs as $user from $DIR with $node."
}

cmd_install() {
  # Reinstalling keeps the user the service runs as; --user NAME changes it.
  local before user=""
  before="$(unit_value User)"
  case "$#:${1:-}" in
    0:) user="$before" ;;
    2:--user) user="$2"; id "$user" > /dev/null 2>&1 || { echo "No user named $user." >&2; exit 1; } ;;
    *) echo "Usage: kevins-food-map install [--user NAME]" >&2; exit 1 ;;
  esac
  [ -f "$DIR/.env" ] || echo "Warning: $DIR/.env not found; copy .env.example to .env and add your key." >&2
  if [ -f "$DIR/.env" ] && [ "$(stat -c %a "$DIR/.env")" != 600 ]; then
    chmod 600 "$DIR/.env" 2> /dev/null || echo "Note: couldn't make .env private (not its owner); run: sudo chmod 600 $DIR/.env" >&2
  fi
  mkdir -p "$DIR/data"
  [ -f "$DIR/$DATA" ] || echo '[]' > "$DIR/$DATA"
  if [ -z "$user" ]; then # a new service runs as whoever installs it (with sudo: the sudo user)
    if [ "$(id -u)" -eq 0 ]; then user="${SUDO_USER:-root}"; else user="$(id -un)"; fi
  fi
  # install uses the Node on your PATH (that's how you switch Node versions);
  # update and move keep the service's.
  local node prev was; prev="$(unit_node)"; was="$(unit_value WorkingDirectory)"
  node="$(command -v node || true)"; [ -n "$node" ] || { echo "node not found on PATH. Install Node.js 22+ first." >&2; exit 1; }
  node="$(readlink -f "$node")"
  check_node_version "$node"
  check_access "$user" "$DIR" "$node"
  render_unit "$user" "$node"
  [ -z "$was" ] || [ "$was" = "$DIR" ] || echo "The service now runs this copy ($DIR) instead of $was; this copy's .env and restaurant list are the live ones."
  [ -z "$prev" ] || [ "$prev" = "$node" ] || echo "Node changed from $prev to $node ($("$node" -v))."
  [ -z "$before" ] || [ "$before" = "$(unit_value User)" ] || echo "The service user changed from $before to $(unit_value User)."
  sudo_ systemctl enable "$SERVICE"
  sudo_ ln -sf "$DIR/bin/kevins-food-map" /usr/local/bin/kevins-food-map
  if case "$(systemctl is-active "$SERVICE" || true)" in active|activating|reloading|failed) true ;; *) false ;; esac; then
    sudo_ systemctl reset-failed "$SERVICE" 2> /dev/null || true
    start_checked restart || exit 1
    echo "Installed and restarted."
  else
    echo "Installed. Start it with: kevins-food-map start"
  fi
}

# Moves the whole app folder (code, .env, restaurant list, backups) and points
# the service and the kevins-food-map command at the new place. Only within
# one disk, where a move is a single rename that either happens or doesn't;
# everything that could fail is checked before the service is stopped.
cmd_move() {
  # Globals, not locals: the exit trap may run after this function returns.
  dest="${1:-}" parent="" user="" node="" state="" switched=0 old="$DIR"
  [ -n "$dest" ] || { echo "Usage: kevins-food-map move /new/folder" >&2; exit 1; }
  need_unit
  [ "$(unit_value WorkingDirectory)" = "$DIR" ] || { echo "Run move from the copy the service uses (see the note above)." >&2; exit 1; }
  dest="$(realpath -m -- "$dest")"
  parent="$(dirname "$dest")"
  [ ! -e "$dest" ] || { echo "$dest already exists. Pick a new folder name." >&2; exit 1; }
  [ -d "$parent" ] || { echo "$parent doesn't exist. Create it first." >&2; exit 1; }
  case "$dest/" in "$DIR"/*) echo "Can't move the folder into itself." >&2; exit 1 ;; esac
  case "$dest/" in /tmp/*|/var/tmp/*) echo "The service can't see /tmp or /var/tmp. Pick another place." >&2; exit 1 ;; esac
  check_path "$dest"
  [ ! -f "$DIR/.env" ] || [ -r "$DIR/.env" ] || { echo "Can't read $DIR/.env to check it. Run the move with sudo." >&2; exit 1; }
  local df
  df="$( (sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}DATA_FILE[[:space:]]*=[[:space:]]*//p" "$DIR/.env" 2> /dev/null || true) | head -n 1 | sed "s/[[:space:]]*#.*$//; s/^[\"']//; s/[\"']$//")"
  case "$df" in /*) case "$(realpath -m -- "$df")/" in "$DIR"/*)
    echo "DATA_FILE in .env points inside this folder by its full path. Make it relative (e.g. data/restaurants.json) first." >&2; exit 1 ;; esac ;; esac
  [ ! -f "$DIR/$KEEP" ] || { echo "$KEEP exists: an update was interrupted. Sort that out first (see: kevins-food-map update)." >&2; exit 1; }
  for d in "$parent" "$(dirname "$DIR")" "$DIR"; do
    [ -w "$d" ] || { echo "You can't write to $d. Run the move with sudo, or pick a folder you own." >&2; exit 1; }
  done
  [ "$(stat -c %d "$DIR")" = "$(stat -c %d "$parent")" ] || { other_disk; exit 1; }
  user="$(unit_value User)"
  node="$(unit_node)" # same Node as now
  [ -n "$node" ] || { echo "The service's Node is missing. Run: kevins-food-map install, then move again." >&2; exit 1; }
  check_access "$user" "$DIR" "$node"
  if [ -n "$user" ] && [ "$user" != "$(id -un)" ] && ! as_user "$user" test -x "$parent"; then
    echo "The service user ($user) can't open $parent. Pick a folder it can reach." >&2; exit 1
  fi

  # From here, an error or Ctrl+C puts the folder back and restarts the service.
  trap 'move_cleanup' EXIT
  trap 'exit 130' INT TERM HUP
  state="$(systemctl is-active "$SERVICE" || true)"
  sudo_ systemctl stop "$SERVICE"
  # A plain rename: it either happens or doesn't, and never falls back to
  # copying (which mv does across mounts, and can leave two half folders).
  rename_dir "$DIR" "$dest" || { [ $? != 2 ] || other_disk_hint=1; exit 1; }
  DIR="$dest"
  render_unit "$user" "$node"
  sudo_ ln -sf "$DIR/bin/kevins-food-map" /usr/local/bin/kevins-food-map
  switched=1
  echo "Moved to $DIR."
  case "$state" in active|activating|reloading)
    if sudo_ systemctl start "$SERVICE" && sleep 2 && systemctl is-active --quiet "$SERVICE"; then
      echo "The service is running again."
    else
      echo "The service didn't start. See: kevins-food-map logs" >&2
      exit 1
    fi ;;
  esac
}
# Exits 2 if the two places are on different disks or mounts.
rename_dir() {
  "$node" -e 'try { require("fs").renameSync(process.argv[1], process.argv[2]) }
    catch (e) { console.error(`Could not move the folder: ${e.message}`); process.exit(e.code === "EXDEV" ? 2 : 1) }' "$1" "$2"
}
other_disk() {
  echo "$parent is on another disk, so the folder can't be moved in one step. Copy it yourself:" >&2
  echo "  sudo systemctl stop $SERVICE && sudo cp -a $DIR $dest && $dest/bin/kevins-food-map install && kevins-food-map start" >&2
  echo "then delete $DIR once the app works. (The service user must be able to reach $dest.)" >&2
}
move_cleanup() {
  trap '' INT TERM HUP
  set +e
  [ "$switched" = 0 ] || return 0
  # Decided by what's on disk, not a flag: Ctrl+C can land right after the rename.
  if [ -e "$dest" ] && [ ! -e "$old" ]; then
    if rename_dir "$dest" "$old"; then
      DIR="$old"; render_unit "$user" "$node" > /dev/null 2>&1; sudo_ ln -sf "$DIR/bin/kevins-food-map" /usr/local/bin/kevins-food-map
      echo "Move stopped; the folder is back in $old." >&2
    else
      echo "Move stopped halfway: the folder is in $dest but the service may still point at $old. Fix with: $dest/bin/kevins-food-map install" >&2
      return 0
    fi
  else
    echo "Move stopped; nothing was moved." >&2
    [ -z "${other_disk_hint:-}" ] || other_disk
  fi
  case "$state" in active|activating|reloading) sudo_ systemctl start "$SERVICE" ;; esac
}

cmd_uninstall() {
  need_unit
  local where; where="$(unit_value WorkingDirectory)"
  sudo_ systemctl disable --now "$SERVICE"
  sudo_ rm -f "$UNIT" "$UNIT.tmp"
  sudo_ systemctl daemon-reload
  [ "$(readlink -f /usr/local/bin/kevins-food-map 2>/dev/null)" = "$DIR/bin/kevins-food-map" ] && sudo_ rm -f /usr/local/bin/kevins-food-map
  echo "Removed. Your data in $where/data is untouched."
}

# This server's restaurant list is the live one. During an update the
# service is stopped (so nothing is saved meanwhile), the list is set aside
# next to itself as restaurants.json.keep, the code is pulled, and the list is
# put back. It is put back even if the update fails or is interrupted, and the
# service is started again either way. (Changes to the list in GitHub are not
# applied; daily backups are in data/backups/.) If the tests fail, the code
# goes back to what it was.
KEEP="$DATA.keep"

set_aside() {
  # (If it's already set aside, the copy in $DATA is git's, not the live one.)
  [ -f "$DIR/$KEEP" ] || as_owner mv -f "$DIR/$DATA" "$DIR/$KEEP"
  # Make the working copy match git so the pull or reset can't trip over it.
  if git_ ls-files --error-unmatch "$DATA" > /dev/null 2>&1; then git_ checkout -- "$DATA"; fi
}
roll_back() {
  set_aside
  if git_ reset --keep "$old"; then
    echo "The code was rolled back to $(git_ rev-parse --short HEAD)." >&2
  else
    echo "Couldn't roll the code back to $old (see above); the service stays stopped. Fix it, then: kevins-food-map start" >&2
    running=0
  fi
}
on_exit() {
  trap '' INT TERM HUP # finish cleaning up even if Ctrl+C is pressed again
  set +e
  # (Checked by commit, not by a flag: Ctrl+C can land after git moved HEAD.)
  if [ "$tested" = 0 ] && [ "$(git_ rev-parse HEAD)" != "$old" ]; then roll_back; fi
  put_back
  if [ "$running" = 1 ] && ! sudo_ systemctl start "$SERVICE"; then
    echo "The service is stopped and couldn't be started. Run: kevins-food-map start" >&2
  fi
}
put_back() {
  [ -f "$DIR/$KEEP" ] || return 0
  as_owner mkdir -p "$DIR/data"
  as_owner mv -f "$DIR/$KEEP" "$DIR/$DATA"
}

cmd_update() {
  [ -f "$DIR/$DATA" ] || { echo "$DATA is missing. Restore it from data/backups/ (or: git -C $DIR checkout -- $DATA) and try again." >&2; exit 1; }
  if [ -f "$DIR/$KEEP" ]; then
    echo "$KEEP exists: an earlier update was interrupted. It holds the live list; check it and move it over $DATA, then try again." >&2; exit 1
  fi
  if [ -f "$UNIT" ] && [ "$(unit_value WorkingDirectory)" != "$DIR" ]; then
    need_unit; echo "Run update from the copy the service uses." >&2; exit 1
  fi
  # Globals, not locals: the exit trap runs after this function has returned.
  old="" running=0 user="" node="" upstream_changed=0 tested=0
  old="$(git_ rev-parse HEAD)"
  # Whatever happens from here (error, Ctrl+C), go back to the old code if the
  # new code hasn't passed its tests, put the list back, and start the service
  # again if it was running.
  trap 'on_exit' EXIT
  trap 'exit 130' INT TERM HUP
  if [ -f "$UNIT" ]; then
    user="$(unit_value User)"
    node="$(pick_node)" # keep the service's Node (sudo's PATH may differ)
    check_access "$user" "$DIR" "$node"
    # running=1 first: if Ctrl+C lands during the stop, the exit trap still starts it again.
    case "$(systemctl is-active "$SERVICE" || true)" in
      active|activating|reloading) running=1; sudo_ systemctl stop "$SERVICE" ;;
    esac
  fi
  local path="$PATH"
  [ -z "$node" ] || path="$(dirname "$node"):$PATH"

  set_aside
  git_ pull --ff-only || { echo "git pull failed; nothing changed." >&2; exit 1; }
  git_ diff --quiet "$old" HEAD -- "$DATA" || upstream_changed=1
  put_back
  [ "$upstream_changed" = 0 ] || echo "Note: $DATA changed in GitHub; this server kept its own list." >&2

  if ! (cd "$DIR" && as_owner env PATH="$path" npm test); then
    echo "Tests failed." >&2
    exit 1 # the exit trap rolls back
  fi
  tested=1
  if [ -f "$UNIT" ]; then
    render_unit "$user" "$node"
    if [ "$running" = 1 ]; then
      running=0 # started here; the exit trap needn't
      start_checked start || exit 1
      echo "Updated to $(git_ rev-parse --short HEAD) and restarted."
    else
      echo "Updated to $(git_ rev-parse --short HEAD). The service was stopped; start it with: kevins-food-map start"
    fi
  else
    echo "Updated to $(git_ rev-parse --short HEAD)."
  fi
}

case "${1:-}" in
  install)   shift; cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  start|stop|restart) need_unit; sudo_ systemctl "$1" "$SERVICE"; systemctl --no-pager --lines=0 status "$SERVICE" || true ;;
  status)    need_unit; systemctl --no-pager status "$SERVICE" ;;
  logs)      need_unit; sudo_ journalctl -u "$SERVICE" -f --no-pager ;;
  test)      cd "$DIR" && npm test ;;
  set-password) cd "$DIR" && node scripts/set-password.js && { [ -f "$UNIT" ] && echo "Then: kevins-food-map restart" || true; } ;;
  update)    cmd_update ;;
  move)      cmd_move "${2:-}" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
